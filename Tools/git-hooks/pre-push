#!/usr/bin/env bash
# Git pre-push hook for Project Ascendant
# Blocks direct pushes to main and force pushes, and runs Git LFS pre-push.

remote="$1"
url="$2"

zero="0000000000000000000000000000000000000000"

# Read all lines from standard input so both checks can use it
stdin_data=$(cat)

while read -r local_ref local_oid remote_ref remote_oid
do
    [ -z "$remote_ref" ] && continue

    # 1. Block direct push to protected branches (main, master)
    if [ "$remote_ref" = "refs/heads/main" ] || [ "$remote_ref" = "refs/heads/master" ]; then
        # Check if caller explicitly bypassed via verified merge workflow
        if [ "$ALLOW_MAIN_PUSH" != "1" ]; then
            echo "[GIT HOOK ERROR] Direct push to protected branch ('${remote_ref}') is BLOCKED by Project Ascendant Autonomous Policy." >&2
            echo "You must work on a feature/docs/infra branch and merge to main only after all QA gates pass." >&2
            exit 1
        fi
    fi

    # 2. Block force push / branch deletion of protected branches
    if [ "$local_oid" = "$zero" ] && ([ "$remote_ref" = "refs/heads/main" ] || [ "$remote_ref" = "refs/heads/master" ]); then
        echo "[GIT HOOK ERROR] Deletion of protected branch ('${remote_ref}') is BLOCKED." >&2
        exit 1
    fi

    # Check for force push (non-fast-forward) if remote_oid is not zero
    if [ "$remote_oid" != "$zero" ] && [ "$local_oid" != "$zero" ]; then
        # Check if remote_oid is an ancestor of local_oid
        if ! git merge-base --is-ancestor "$remote_oid" "$local_oid" 2>/dev/null; then
            echo "[GIT HOOK ERROR] Force push (non-fast-forward) is strictly PROHIBITED." >&2
            exit 1
        fi
    fi
done <<< "$stdin_data"

# 3. Git LFS pre-push execution
command -v git-lfs >/dev/null 2>&1 || { echo >&2 "\nThis repository is configured for Git LFS but 'git-lfs' was not found on your path. If you no longer wish to use Git LFS, remove this hook by deleting the 'pre-push' file in the hooks directory (set by 'core.hookspath'; usually '.git/hooks').\n"; exit 2; }
printf '%s' "$stdin_data" | git lfs pre-push "$@"

exit 0
